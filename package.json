{
  "name": "colors-lab",
  "version": "1.0.0",
  "private": true,
  "description": "COLORS LAMP app - Node is used only for linting tools",
  "scripts": {
    "lint:html": "htmlhint \"**/*.html\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:js": "eslint .",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "htmlhint": "^1.9.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
